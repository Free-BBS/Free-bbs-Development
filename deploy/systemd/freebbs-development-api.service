[Unit]
Description=FreeBBS Development API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=freebbs-development
Group=freebbs-development
WorkingDirectory=/opt/freebbs-development/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/freebbs-development/development.env
ExecStart=/usr/bin/node apps/api/dist/server.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
