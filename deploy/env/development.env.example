# Installed once as /etc/freebbs-development/development.env (0640).
# Replace every CHANGE_ME value before deploying or starting services.
AUTH_MODE=main
MAIN_SITE_API_BASE_URL=https://CHANGE_ME
AUTH_TIMEOUT_MS=3000
ALLOWED_ORIGINS=https://CHANGE_ME
DATA_MODE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=free_bbs_development
MYSQL_USER=freebbs_development_app
MYSQL_PASSWORD=CHANGE_ME
PORT=3100
HOST=127.0.0.1
