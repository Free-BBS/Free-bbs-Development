{
  "name": "freebbs-development",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web npm:dev:api npm:dev:web",
    "dev:api": "npm run dev -w @freebbs-development/api",
    "dev:web": "npm run dev -w @freebbs-development/web",
    "build": "npm run build -ws --if-present",
    "test": "vitest run",
    "test:operations": "node --test tests/scripts/operational-scripts.test.mjs",
    "test:workflows": "node --test tests/workflows/release-workflows.test.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "typecheck": "npm run typecheck -ws --if-present",
    "lint": "eslint .",
    "format:check": "prettier . --check",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run test:operations && npm run test:workflows && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "jsdom": "26.1.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
