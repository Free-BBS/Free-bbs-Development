{
  "name": "freebbs-development",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web npm:dev:api npm:dev:web",
    "dev:api": "npm run dev -w @freebbs-development/api",
    "dev:web": "npm run dev -w @freebbs-development/web",
    "build": "npm run build -ws --if-present",
    "test": "vitest run",
    "typecheck": "npm run typecheck -ws --if-present",
    "lint": "eslint .",
    "format:check": "prettier . --check",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  }
}
